rules_version = '2';

// SafeRide's Firestore Security Rules — the security boundary for every
// account's data (docs/firebase-architecture.md §8). The app's own checks
// are for feedback; everything that must hold is restated here.
//
// - Only a signed-in user reaches their own `users/{uid}`; nobody else does.
// - Every document's fields are listed, typed and sized.
// - Server timestamps (`createdAt`, `updatedAt`) must be the server's time.
// - A journey starts (planned → active) only in the same write as its
//   complete pre-journey checklist record; only a planned journey is
//   edited; active → completed; closing changes only the status; a closed
//   journey never reopens.
// - A journey's recorded route (chunks of points and one summary) is the
//   owner's alone, and only exists under a journey that has started.
// - An unanswered safety check reaches the server as one write of the check
//   and its incident, never changed afterwards. What became of it
//   (escalations and their attempts, contact links, alerts received) is
//   written by the backend only: no client can mark anything sent or
//   delivered, or make itself someone's contact.
// - A share's link is a bearer credential: its 256-bit token is the id of a
//   public document anyone holding the link may read, one at a time, until it
//   expires. Nobody can list them, and they hold no owner: rules cannot hide a
//   field, so who owns a share is only ever in users/{uid}/shares/{token}.
// - A connection between two accounts is made only by accepting an invite,
//   in one write: the invite and both sides' records, which is the one time
//   an account writes into another's. It grants nothing: no rule anywhere
//   reads a connection to open a journey, a route, a location or a share.
// - Anything not matched below is refused.
//
// Deploy: firebase deploy --only firestore:rules (see firebase.json).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function text(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function optionalText(d, k, min, max) {
      return !(k in d) || d[k] == null || text(d[k], min, max);
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // The profile. Email and passwords live in Firebase Authentication, never
    // here.
    match /users/{uid} {
      function validProfile(d) {
        return d.keys().hasOnly(['fullName', 'phone', 'locale', 'country',
                                 'updatedAt'])
          && d.keys().hasAll(['fullName', 'updatedAt'])
          && text(d.fullName, 2, 200)
          && optionalText(d, 'phone', 7, 25)
          && (!('locale' in d) || d.locale in ['ar', 'en'])
          // The country the user says they are in (ISO 3166-1 alpha-2): what
          // the emergency numbers follow. A new country needs no new rule.
          && (!('country' in d) || (d.country is string
                                     && d.country.matches('^[A-Z]{2}$')))
          && d.updatedAt == request.time;
      }

      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);
      allow delete: if isOwner(uid);

      match /journeys/{journeyId} {
        // A place picked on the map. Optional: a journey needs only the
        // user's own words, and every journey from before maps has none.
        function validPlace(d, k) {
          return !(k in d) || (
            d[k] is map
            && d[k].keys().hasOnly(['name', 'lat', 'lng', 'address', 'placeId'])
            && d[k].keys().hasAll(['name', 'lat', 'lng'])
            && text(d[k].name, 1, 200)
            && d[k].lat is number && d[k].lat >= -90 && d[k].lat <= 90
            && d[k].lng is number && d[k].lng >= -180 && d[k].lng <= 180
            && optionalText(d[k], 'address', 1, 400)
            && optionalText(d[k], 'placeId', 1, 100)
          );
        }

        function validEstimate(d, k) {
          return !(k in d) || (d[k] is number && d[k] >= 0);
        }

        function validJourney(d) {
          return d.keys().hasOnly(['origin', 'destination', 'departsAt',
                                   'status', 'createdAt', 'updatedAt',
                                   'startedAt', 'originPlace',
                                   'destinationPlace', 'plannedDistanceMeters',
                                   'plannedDurationSeconds'])
            && d.keys().hasAll(['origin', 'destination', 'departsAt',
                                'status', 'createdAt', 'updatedAt'])
            && text(d.origin, 2, 120)
            && text(d.destination, 2, 120)
            && d.departsAt is timestamp
            && d.status in ['planned', 'active', 'completed', 'cancelled']
            && validPlace(d, 'originPlace')
            && validPlace(d, 'destinationPlace')
            && validEstimate(d, 'plannedDistanceMeters')
            && validEstimate(d, 'plannedDurationSeconds')
            && d.updatedAt == request.time;
        }

        function checklistPath() {
          return /databases/$(database)/documents/users/$(uid)/journeys/$(journeyId)/checklists/preJourney;
        }

        // The journey only starts in the same write as its complete checklist
        // record (see `checklists` below).
        function startedWithChecklist() {
          return existsAfter(checklistPath())
            && getAfter(checklistPath()).data.complete == true;
        }

        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validJourney(request.resource.data)
          && request.resource.data.status == 'planned'
          && !('startedAt' in request.resource.data)
          && request.resource.data.createdAt == request.time;
        // planned: edited (staying planned, never given a start time),
        //   cancelled, or started — only with its checklist;
        // active: completed or cancelled, nothing else changing;
        // completed / cancelled: never change again.
        allow update: if isOwner(uid)
          && validJourney(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            (resource.data.status == 'planned'
              && request.resource.data.status == 'planned'
              && !('startedAt' in request.resource.data))
            || (resource.data.status == 'planned'
              && request.resource.data.status == 'cancelled'
              && changedOnly(['status', 'updatedAt']))
            || (resource.data.status == 'planned'
              && request.resource.data.status == 'active'
              && changedOnly(['status', 'updatedAt', 'startedAt'])
              && request.resource.data.startedAt == request.time
              && startedWithChecklist())
            || (resource.data.status == 'active'
              && request.resource.data.status in ['completed', 'cancelled']
              && changedOnly(['status', 'updatedAt']))
          );
        // The app never deletes a journey; the owner may (account clean-up).
        allow delete: if isOwner(uid);

        // The pre-journey safety checklist: one record per journey, written
        // with the journey's start and never changed — history keeps exactly
        // what was confirmed, under the version that asked it.
        match /checklists/{checklistId} {
          function journeyPath() {
            return /databases/$(database)/documents/users/$(uid)/journeys/$(journeyId);
          }

          // Each released version's items. A new version adds a line here
          // and in `JourneyChecklist.versions`; old lines stay.
          function confirmsVersion(d) {
            return d.version == 1
              && d.items.size() == 9
              && d.items.hasAll(['vehicle', 'energy', 'tiresBrakes',
                                 'documents', 'fitness', 'sober',
                                 'phoneBattery', 'contacts', 'assistance']);
          }

          function validChecklist(d) {
            return d.keys().hasOnly(['journeyId', 'uid', 'version', 'items',
                                     'complete', 'completedAt'])
              && d.keys().hasAll(['journeyId', 'uid', 'version', 'items',
                                  'complete', 'completedAt'])
              && d.journeyId == journeyId
              && d.uid == uid
              && d.version is int
              && d.items is list
              && d.complete == true
              && confirmsVersion(d)
              && d.completedAt == request.time;
          }

          allow read: if isOwner(uid);
          // Only together with the journey going from planned to active.
          allow create: if isOwner(uid)
            && checklistId == 'preJourney'
            && validChecklist(request.resource.data)
            && get(journeyPath()).data.status == 'planned'
            && getAfter(journeyPath()).data.status == 'active';
          allow update: if false;
          allow delete: if isOwner(uid);
        }

        // The route the phone recorded while the journey was in progress
        // (JourneyTracker), sent in chunks of at most 100 points - possibly
        // after the journey ended, when the phone was offline. A retry
        // rewrites the same chunk.
        function started() {
          return get(/databases/$(database)/documents/users/$(uid)/journeys/$(journeyId))
            .data.status in ['active', 'completed', 'cancelled'];
        }

        match /route/{chunkId} {
          function validPoint(p) {
            return p is map
              && p.keys().hasOnly(['lat', 'lng', 'at', 'acc', 'spd', 'seg'])
              && p.keys().hasAll(['lat', 'lng', 'at', 'acc', 'seg'])
              && p.lat is number && p.lat >= -90 && p.lat <= 90
              && p.lng is number && p.lng >= -180 && p.lng <= 180
              && p.at is timestamp
              && p.acc is number && p.acc >= 0
              && (!('spd' in p) || p.spd == null || (p.spd is number && p.spd >= 0))
              && p.seg is int && p.seg >= 0;
          }

          // Rules cannot loop: the first and last points are checked, and
          // the size is bounded.
          function validChunk(d) {
            return d.keys().hasOnly(['chunk', 'points', 'updatedAt'])
              && d.keys().hasAll(['chunk', 'points', 'updatedAt'])
              && chunkId.matches('^[0-9]{5}$')
              && d.chunk is int && d.chunk == int(chunkId)
              && d.points is list
              && d.points.size() >= 1 && d.points.size() <= 100
              && validPoint(d.points[0])
              && validPoint(d.points[d.points.size() - 1])
              && d.updatedAt == request.time;
          }

          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && validChunk(request.resource.data)
            && started();
          allow delete: if isOwner(uid);
        }

        match /tracking/{docId} {
          function validSummary(d) {
            return d.keys().hasOnly(['distanceMeters', 'pointCount',
                                     'recording', 'firstAt', 'lastAt',
                                     'updatedAt'])
              && d.keys().hasAll(['distanceMeters', 'pointCount', 'recording',
                                  'updatedAt'])
              && d.distanceMeters is number && d.distanceMeters >= 0
              && d.pointCount is int && d.pointCount >= 0
              && d.recording is bool
              && (!('firstAt' in d) || d.firstAt == null || d.firstAt is timestamp)
              && (!('lastAt' in d) || d.lastAt == null || d.lastAt is timestamp)
              && d.updatedAt == request.time;
          }

          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && docId == 'summary'
            && validSummary(request.resource.data)
            && started();
          allow delete: if isOwner(uid);
        }
      }

      match /contacts/{contactId} {
        function validContact(d) {
          return d.keys().hasOnly(['fullName', 'phone', 'phoneDigits',
                                   'relationship', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['fullName', 'phone', 'phoneDigits',
                                'createdAt', 'updatedAt'])
            && text(d.fullName, 2, 200)
            && text(d.phone, 7, 25)
            && d.phoneDigits is string
            && d.phoneDigits.matches('^[0-9]{7,20}$')
            && optionalText(d, 'relationship', 1, 40)
            && d.updatedAt == request.time;
        }

        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && validContact(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid)
          && validContact(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      // An unanswered safety check, as the phone reports it: the request the
      // backend acts on (functions/src/escalation.ts), which checks it all
      // again. The check and its incident arrive in one write, offline too,
      // and are the record of what the phone said: nothing changes them.
      match /safetyChecks/{checkId} {
        function incidentPath(d) {
          return /databases/$(database)/documents/users/$(uid)/incidents/$(d.incidentId);
        }

        function validCheck(d) {
          return d.keys().hasOnly(['uid', 'journeyId', 'incidentId', 'status',
                                   'startedAt', 'deadline', 'timedOutAt',
                                   'escalationReadyAt', 'syncedAt'])
            && d.keys().hasAll(['uid', 'journeyId', 'incidentId', 'status',
                                'startedAt', 'deadline', 'timedOutAt',
                                'escalationReadyAt', 'syncedAt'])
            && d.uid == uid
            && text(d.journeyId, 1, 128)
            && text(d.incidentId, 1, 200)
            && d.status == 'escalationReady'
            && d.startedAt is timestamp
            && d.deadline is timestamp
            && d.deadline < request.time
            && d.timedOutAt == d.deadline
            && d.escalationReadyAt is timestamp
            && d.syncedAt == request.time;
        }

        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validCheck(request.resource.data)
          && exists(/databases/$(database)/documents/users/$(uid)/journeys/$(request.resource.data.journeyId))
          && existsAfter(incidentPath(request.resource.data))
          && getAfter(incidentPath(request.resource.data)).data.safetyCheckId == checkId
          && getAfter(incidentPath(request.resource.data)).data.journeyId == request.resource.data.journeyId;
        allow update, delete: if false;
      }

      // The potential incident a safety check asked about: what the backend
      // needs, and no location.
      match /incidents/{incidentId} {
        function validIncident(d) {
          return d.keys().hasOnly(['journeyId', 'safetyCheckId', 'type',
                                   'confidence', 'detectedAt', 'createdAt'])
            && d.keys().hasAll(['journeyId', 'safetyCheckId', 'type',
                                'confidence', 'detectedAt', 'createdAt'])
            && text(d.journeyId, 1, 128)
            && text(d.safetyCheckId, 1, 200)
            && d.type in ['suddenDeceleration', 'prolongedStop']
            && d.confidence in ['medium', 'high']
            && d.detectedAt is timestamp
            && d.createdAt == request.time;
        }

        allow read: if isOwner(uid);
        // Only together with its safety check.
        allow create: if isOwner(uid)
          && validIncident(request.resource.data)
          && !exists(/databases/$(database)/documents/users/$(uid)/safetyChecks/$(request.resource.data.safetyCheckId))
          && existsAfter(/databases/$(database)/documents/users/$(uid)/safetyChecks/$(request.resource.data.safetyCheckId));
        allow update, delete: if false;
      }

      // What the backend did about a request: its status and one attempt per
      // contact. The owner reads it; only the backend writes it.
      match /escalations/{escalationId} {
        allow read: if isOwner(uid);
        allow write: if false;

        match /attempts/{attemptId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      // Who accepted this user's invite, by contact. The backend writes it
      // when the invited person accepts, so nobody links themselves.
      match /contactLinks/{contactId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Alerts this user received as someone's trusted contact: the only
      // copy of another account's data they ever see, and it holds no
      // location.
      match /receivedAlerts/{alertId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Which shares are this account's. This record is the proof of
      // ownership the public document cannot carry, and what finds a share
      // again from another phone or when the account is deleted. It holds the
      // token, so it is the owner's alone.
      match /shares/{token} {
        function publicShare() {
          return /databases/$(database)/documents/shares/$(token);
        }

        function validRecord(d) {
          return d.keys().hasOnly(['kind', 'journeyId', 'createdAt', 'expiresAt'])
            && d.keys().hasAll(['kind', 'createdAt', 'expiresAt'])
            && ((d.kind == 'journey' && text(d.journeyId, 1, 128))
                || (d.kind == 'location' && !('journeyId' in d)))
            && d.expiresAt is timestamp;
        }

        allow read: if isOwner(uid);
        // Only in the write that creates the public document: a token that
        // already exists can never be claimed, leaked or not.
        allow create: if isOwner(uid)
          && token.matches('^[A-Za-z0-9_-]{43}$')
          && validRecord(request.resource.data)
          && request.resource.data.createdAt == request.time
          && !exists(publicShare())
          && existsAfter(publicShare());
        allow update: if isOwner(uid)
          && validRecord(request.resource.data)
          && changedOnly(['expiresAt'])
          && request.resource.data.expiresAt <= resource.data.expiresAt;
        // Never before the public document: nothing could delete that after.
        allow delete: if isOwner(uid) && !existsAfter(publicShare());
      }

      // Who this account is connected to: one record per side, so a nickname
      // stays its owner's, and the id is the other account, so a pair exists
      // once. Only the owner reads it. The other side can do one thing to it:
      // end it. Nothing here opens anything else.
      match /connections/{contactUid} {
        function theirSide() {
          return /databases/$(database)/documents/users/$(contactUid)/connections/$(uid);
        }

        function validConnection(d) {
          return d.keys().hasOnly(['ownerUid', 'contactUid', 'contactName',
                                   'status', 'inviteId', 'createdAt',
                                   'acceptedAt', 'nickname', 'permissions',
                                   'revokedAt', 'revokedBy'])
            && d.keys().hasAll(['ownerUid', 'contactUid', 'contactName',
                                'status', 'inviteId', 'createdAt', 'acceptedAt',
                                'permissions'])
            && d.ownerUid == uid
            && d.contactUid == contactUid
            && text(d.contactName, 2, 200)
            && d.inviteId.matches('^[A-Za-z0-9_-]{43}$')
            && optionalText(d, 'nickname', 1, 60)
            // Nothing can be switched on: no backend exists to act on it.
            && d.permissions == {'safetyAlerts': false};
        }

        // The write that accepts an invite, and only that write: `acceptedAt`
        // equal to this request's time cannot be replayed. Each side's name is
        // the one the other account really has, so nobody can pose as someone
        // else.
        function accepting(d) {
          let invite = getAfter(/databases/$(database)/documents/connectionInvites/$(d.inviteId)).data;
          return signedIn()
            && validConnection(d)
            && d.status == 'accepted'
            && !d.keys().hasAny(['revokedAt', 'revokedBy', 'nickname'])
            && invite.status == 'accepted'
            && invite.acceptedBy == request.auth.uid
            && invite.acceptedAt == request.time
            && d.acceptedAt == request.time
            && d.createdAt == invite.createdAt
            && ((uid == request.auth.uid
                  && contactUid == invite.inviterUid
                  && d.contactName == invite.inviterName)
                || (uid == invite.inviterUid
                  && contactUid == request.auth.uid
                  && d.contactName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.fullName));
        }

        function ending() {
          return signedIn()
            && (request.auth.uid == uid || request.auth.uid == contactUid)
            && resource.data.status == 'accepted'
            && request.resource.data.status == 'revoked'
            && request.resource.data.revokedAt == request.time
            && request.resource.data.revokedBy == request.auth.uid
            && changedOnly(['status', 'revokedAt', 'revokedBy']);
        }

        function renaming() {
          return isOwner(uid)
            && resource.data.status == 'accepted'
            && changedOnly(['nickname'])
            && optionalText(request.resource.data, 'nickname', 1, 60);
        }

        allow read: if isOwner(uid);
        allow create: if accepting(request.resource.data);
        // An ended connection comes back only through a new invite.
        allow update: if ending()
          || renaming()
          || (resource.data.status == 'revoked' && accepting(request.resource.data));
        // Never leaving the other side believing it is still connected.
        allow delete: if isOwner(uid)
          && (resource.data.status == 'revoked'
              || !existsAfter(theirSide())
              || getAfter(theirSide()).data.status == 'revoked');
      }

      // One per install that receives notifications: its FCM installation id.
      match /devices/{installId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['fid', 'platform', 'updatedAt'])
          && request.resource.data.keys().hasAll(['fid', 'platform', 'updatedAt'])
          && text(request.resource.data.fid, 10, 4096)
          && request.resource.data.platform in ['android', 'ios']
          && request.resource.data.updatedAt == request.time;
      }
    }

    // What someone holding a share's link sees. The token is the document's
    // id and the only way in: it reads one document, never a list, and only
    // until `expiresAt`, checked here against the server's clock whether or
    // not the owner's phone is running. Stopping a share deletes it.
    match /shares/{token} {
      function ownerRecord() {
        return /databases/$(database)/documents/users/$(request.auth.uid)/shares/$(token);
      }

      function isShareOwner() {
        return signedIn() && exists(ownerRecord());
      }

      function open(d) {
        return d.expiresAt > request.time;
      }

      function validEnd(d, k) {
        return !(k in d) || (
          d[k] is map
          && d[k].keys().hasOnly(['name', 'lat', 'lng'])
          && d[k].keys().hasAll(['name'])
          && text(d[k].name, 1, 120)
          && (!('lat' in d[k]) || (d[k].lat is number && d[k].lat >= -90 && d[k].lat <= 90))
          && (!('lng' in d[k]) || (d[k].lng is number && d[k].lng >= -180 && d[k].lng <= 180))
        );
      }

      function validLocation(d) {
        return !('location' in d) || (
          d.location is map
          && d.location.keys().hasOnly(['lat', 'lng', 'accuracy', 'fixAt'])
          && d.location.keys().hasAll(['lat', 'lng', 'accuracy', 'fixAt'])
          && d.location.lat is number && d.location.lat >= -90 && d.location.lat <= 90
          && d.location.lng is number && d.location.lng >= -180 && d.location.lng <= 180
          && d.location.accuracy is number
          && d.location.accuracy > 0 && d.location.accuracy <= 50
          && d.location.fixAt is timestamp
        );
      }

      function validShare(d) {
        return d.keys().hasOnly(['kind', 'createdAt', 'expiresAt', 'updatedAt',
                                 'tracking', 'location', 'locationAt', 'origin',
                                 'destination', 'journeyStatus',
                                 'distanceMeters', 'routeChunks',
                                 'routeVersion'])
          && d.keys().hasAll(['kind', 'createdAt', 'expiresAt', 'updatedAt',
                              'tracking', 'routeChunks', 'routeVersion'])
          && d.kind in ['location', 'journey']
          && d.expiresAt is timestamp
          && d.tracking in ['waiting', 'live', 'paused', 'ended']
          && validLocation(d)
          && validEnd(d, 'origin')
          && validEnd(d, 'destination')
          && (!('journeyStatus' in d) || d.journeyStatus in ['active', 'finished'])
          && (!('distanceMeters' in d)
              || (d.distanceMeters is number && d.distanceMeters >= 0))
          && d.routeChunks is int && d.routeChunks >= 0 && d.routeChunks <= 40
          && d.routeVersion is int && d.routeVersion >= 0
          // A share of a location says nothing about any journey.
          && (d.kind == 'journey'
              || !d.keys().hasAny(['origin', 'destination', 'journeyStatus',
                                   'distanceMeters']))
          && d.updatedAt == request.time;
      }

      // A position is stamped by the server as it arrives.
      function stampedLocation() {
        return !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['location', 'locationAt'])
          || (!('location' in request.resource.data)
              && !('locationAt' in request.resource.data))
          || ('location' in request.resource.data
              && request.resource.data.locationAt == request.time);
      }

      allow get: if open(resource.data);
      allow list: if false;

      // At most 12 hours: a share nobody stops still ends by itself.
      allow create: if signedIn()
        && token.matches('^[A-Za-z0-9_-]{43}$')
        && existsAfter(ownerRecord())
        && validShare(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.tracking == 'waiting'
        && !('location' in request.resource.data)
        && !('locationAt' in request.resource.data)
        && request.resource.data.routeChunks == 0
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(12, 'h');

      // Only while open, a finished journey's share never comes back, and the
      // time can only be shortened.
      allow update: if isShareOwner()
        && open(resource.data)
        && (!('journeyStatus' in resource.data) || resource.data.journeyStatus == 'active')
        && validShare(request.resource.data)
        && changedOnly(['updatedAt', 'tracking', 'location', 'locationAt',
                        'journeyStatus', 'distanceMeters', 'routeChunks',
                        'routeVersion', 'expiresAt'])
        && request.resource.data.expiresAt <= resource.data.expiresAt
        && stampedLocation();

      // Stopping a share. Allowed after it expired too, so it can be cleared.
      allow delete: if isShareOwner();

      // The route so far, thinned, for a shared journey: `seg` keeps a gap in
      // the recording a gap on the recipient's map. Read one chunk at a time,
      // by number, from `routeChunks`; only the owner can list them.
      match /route/{chunkId} {
        function parent() {
          return get(/databases/$(database)/documents/shares/$(token)).data;
        }

        function validPoint(p) {
          return p is map
            && p.keys().hasOnly(['lat', 'lng', 'seg'])
            && p.keys().hasAll(['lat', 'lng', 'seg'])
            && p.lat is number && p.lat >= -90 && p.lat <= 90
            && p.lng is number && p.lng >= -180 && p.lng <= 180
            && p.seg is int && p.seg >= 0;
        }

        // Rules cannot loop: the first and last points are checked, and the
        // size is bounded.
        function validChunk(d) {
          return d.keys().hasOnly(['chunk', 'points', 'updatedAt'])
            && d.keys().hasAll(['chunk', 'points', 'updatedAt'])
            && chunkId.matches('^[0-9]{5}$')
            && d.chunk is int && d.chunk == int(chunkId)
            && d.chunk < 40
            && d.points is list
            && d.points.size() >= 1 && d.points.size() <= 200
            && validPoint(d.points[0])
            && validPoint(d.points[d.points.size() - 1])
            && d.updatedAt == request.time;
        }

        allow get: if open(parent());
        allow list: if isShareOwner();
        allow create, update: if isShareOwner()
          && parent().kind == 'journey'
          && open(parent())
          && validChunk(request.resource.data);
        allow delete: if isShareOwner();
      }
    }

    // An invitation to connect. The token is the id and the only way in. Only
    // a signed-in account can read one, by its token, while it is unused and
    // unexpired; it shows the inviter's name and account id, which accepting
    // needs, and nothing else. It works once.
    match /connectionInvites/{token} {
      function openInvite(d) {
        return d.status == 'pending' && d.expiresAt > request.time;
      }

      function connectionPath(owner, contact) {
        return /databases/$(database)/documents/users/$(owner)/connections/$(contact);
      }

      function validInvite(d) {
        return d.keys().hasOnly(['inviterUid', 'inviterName', 'status',
                                 'createdAt', 'expiresAt'])
          && d.keys().hasAll(['inviterUid', 'inviterName', 'status', 'createdAt',
                              'expiresAt'])
          && d.inviterUid == request.auth.uid
          && d.inviterName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.fullName
          && d.status == 'pending'
          && d.createdAt == request.time
          && d.expiresAt is timestamp
          && d.expiresAt > request.time
          // Three days, with an hour for a phone clock that runs fast.
          && d.expiresAt <= request.time + duration.value(73, 'h');
      }

      allow get: if signedIn()
        && (resource.data.inviterUid == request.auth.uid
            || resource.data.get('acceptedBy', null) == request.auth.uid
            || openInvite(resource.data));
      // Only a query for one's own invites.
      allow list: if signedIn() && resource.data.inviterUid == request.auth.uid;

      allow create: if signedIn()
        && token.matches('^[A-Za-z0-9_-]{43}$')
        && validInvite(request.resource.data);

      // Accepting: once, by someone else, with both records in the same write.
      allow update: if signedIn()
        && request.auth.uid != resource.data.inviterUid
        && openInvite(resource.data)
        && exists(/databases/$(database)/documents/users/$(resource.data.inviterUid))
        && changedOnly(['status', 'acceptedBy', 'acceptedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.acceptedAt == request.time
        && existsAfter(connectionPath(request.auth.uid, resource.data.inviterUid))
        && existsAfter(connectionPath(resource.data.inviterUid, request.auth.uid));

      // Cancelling, or clearing away one that is over.
      allow delete: if signedIn() && resource.data.inviterUid == request.auth.uid;
    }

    // Everything else — `contactInvites` (backend only) and whatever later
    // features add — is closed until its rules are written.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
