<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own splash (the launcher icon on a field) before
         the window background is ever seen, and that field defaults to the
         platform's white or black. Giving it the Flutter splash's colour keeps
         the hand-over seamless. Only LaunchTheme needs it — NormalTheme still
         resolves from values/. Same parent as values/styles.xml; keep them in
         step. values-night-v31/ is the dark-mode twin. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <!-- Always the full launcher icon on its 160dp disc. Without it the
             system draws the foreground alone, enlarged, when the icon's
             tile is "similar" to the field (the dark field is), so the
             splash would start from two different images. The Flutter
             splash's frame 0 repeats this one (AppMotion.launchDisc /
             launchGlyph). -->
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
</resources>
