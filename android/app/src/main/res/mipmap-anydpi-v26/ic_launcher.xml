<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon on Android 8+: the SafeRide mark on a navy tile, masked
     to whatever shape the launcher uses. Android 12+ also draws it on the
     system splash. The PNGs in mipmap-*dpi/ remain the fallback for older
     versions. The monochrome layer is the same glyph; Android 13+ tints it for
     themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
