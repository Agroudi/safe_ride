<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Flutter's template declares INTERNET in src/debug and src/profile only,
         because hot reload needs it. A RELEASE build without this line has no
         network at all: google_fonts cannot fetch Cairo on first launch, remote
         images do not load, and any future request fails as "no connection". -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- A journey's route (JourneyTracker), read only while a journey the
         user started is in progress. The recording runs in geolocator's
         foreground service of type "location" (the persistent notice), which
         keeps reading in the background with the while-in-use permission -
         so ACCESS_BACKGROUND_LOCATION is deliberately NOT requested. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>

    <!-- enableOnBackInvokedCallback="false": every back must reach onBackPressed,
         so Flutter's popRoute and AppBackButtonDispatcher see it. With predictive
         back on (the default from targetSdk 36 on Android 16), Flutter hands back
         to the OS whenever the root route cannot pop: splash, onboarding step 1,
         welcome and home then close at once with no "press back again" warning,
         and a screen reached with `go` closes the app instead of going up. -->
    <!-- allowBackup="false": route points, incidents and this install's id stay
         on this phone; a cloud backup would copy them, and a restore would
         reuse the install id. Everything worth keeping is in the account. -->
    <application
        android:label="SafeRide"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false">
        <!-- FCM registers this install by its Firebase Installation ID
             (register() / onRegistered); without it register() is refused.
             See core/push/push_notifications.dart. -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:screenOrientation="portrait"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- "I'm safe" on a safety-check notification. No full-screen intent:
             Android keeps USE_FULL_SCREEN_INTENT for calls and alarm clocks,
             and SafeRide is neither. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Emergency numbers' Call: lets url_launcher ask whether anything
             on this device dials (a tablet may have nothing) before opening
             the phone app with the number ready. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
